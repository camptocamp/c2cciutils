{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'github>camptocamp/gs-renovate-config-preset:base.json5#1.13.1',
    'github>camptocamp/gs-renovate-config-preset:group.json5#1.13.1',
    'github>camptocamp/gs-renovate-config-preset:ci.json5#1.13.1',
    'github>camptocamp/gs-renovate-config-preset:preset.json5#1.13.1',
    'github>camptocamp/gs-renovate-config-preset:pre-commit.json5#1.13.1',
    'github>camptocamp/gs-renovate-config-preset:python.json5#1.13.1',
    'github>camptocamp/gs-renovate-config-preset:docker.json5#1.13.1',
    'github>camptocamp/gs-renovate-config-preset:json-schema.json5#1.13.1',
    'github>camptocamp/gs-renovate-config-preset:shellcheck.json5#1.13.1',
    'github>camptocamp/gs-renovate-config-preset:stabilization-branches.json5#1.13.1',
    'github>camptocamp/gs-renovate-config-preset:own.json5#1.13.1',
    'github>camptocamp/gs-renovate-config-preset:security.json5#1.13.1',
  ],
  baseBranchPatterns: ['master', '1.1', '1.2', '1.3', '1.4', '1.5', '1.6', '1.7'],
  customManagers: [
    {
      matchStrings: [
        '(?<depName>[^\\s]+): (?<currentValue>[^\\s]+) # (?<datasource>[^\\s]+) - (?<registryUrl>[^\\s]+)',
        '(?<depName>[^\\s]+): (?<currentValue>[^\\s]+) # (?<datasource>[^h\\s][^\\s]+)',
      ],
      customType: 'regex',
      managerFilePatterns: ['/^c2cciutils/applications-versions\\.yaml$/'],
    },
  ],
  packageRules: [
    /** Ungroup codespell */
    {
      groupName: 'codespell',
      matchDepNames: ['codespell'],
    },
    /** On branch 1.2 and 1.3 don't upgrade types-pyyaml */
    {
      matchBaseBranches: ['1.2', '1.3'],
      enabled: false,
      matchDepNames: ['types-pyyaml'],
    },
    /** On branch 1.3 don't upgrade poetry-plugin-tweak-dependencies-version */
    {
      matchBaseBranches: ['1.3'],
      enabled: false,
      matchDepNames: ['poetry-plugin-tweak-dependencies-version'],
    },
    /**
     * On branch 1.1 (Python 3.9) don't upgrade to versions that require Python >=3.10, otherwise the
     * Pipfile.lock can't be regenerated and the security auto-merge would re-break it. These are the
     * latest releases still supporting Python 3.9, see https://github.com/camptocamp/c2cciutils/pull/3525.
     */
    {
      matchBaseBranches: ['1.1'],
      matchDepNames: ['pip'],
      allowedVersions: '<26.1',
    },
    {
      matchBaseBranches: ['1.1'],
      matchDepNames: ['setuptools'],
      allowedVersions: '<83',
    },
    {
      matchBaseBranches: ['1.1'],
      matchDepNames: ['requests'],
      allowedVersions: '<2.33',
    },
    {
      matchBaseBranches: ['1.1'],
      matchDepNames: ['urllib3'],
      allowedVersions: '<2.7',
    },
    {
      matchBaseBranches: ['1.1'],
      matchDepNames: ['click'],
      allowedVersions: '<8.2',
    },
    {
      matchBaseBranches: ['1.1'],
      matchDepNames: ['filelock'],
      allowedVersions: '<3.20',
    },
    {
      matchBaseBranches: ['1.1'],
      matchDepNames: ['bleach'],
      allowedVersions: '<6.3',
    },
    {
      matchBaseBranches: ['1.1'],
      matchDepNames: ['pylint'],
      allowedVersions: '<4',
    },
  ],
}
